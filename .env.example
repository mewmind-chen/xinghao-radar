# Optional remote electronics-agent-platform endpoint. Defaults to local :8787.
AGENT_API_URL=http://127.0.0.1:8787

# Dedicated, server-only credential for electronics-agent-platform.
# Do not set or reuse AGENT_API_TOKEN here. Provision a least-privilege token
# specifically for this Radar -> Platform connection.
ELECTRONICS_AGENT_PLATFORM_TOKEN=

# Deterministic fact fallback. Defaults to local Huaqiangbei Workbench :8081.
HQB_BASE_URL=http://127.0.0.1:8081

# Optional production persistence.
DATABASE_URL=

# Project-owned Import Engine rollout. Keep false while validating in Import Lab;
# switch to true only after the fixture benchmark is accepted.
IMPORT_ENGINE_V2_ENABLED=false

# Server-only OpenRouter credential and model. The default model is explicit so
# the import contract does not silently change when a provider updates aliases.
OPENROUTER_API_KEY=
IMPORT_MODEL=google/gemini-3.8-flash

# Optional independent Import Lab process.
IMPORT_LAB_PORT=8090
IMPORT_LAB_DEV_AUTH=false
RADAR_AUTH_BRIDGE_URL=http://127.0.0.1:8082/api/import-lab/access
# IMPORT_LAB_COMPARE_MODEL=
